+"""Event snapshots for measured host idle core-minutes; no periodic worker or lease."""
+import argparse
+import json
+import os
+from pathlib import Path
+import socket
+import time
+
+
+def snapshot(event, name):
+    # /proc/stat aggregates USER_HZ CPU time over cores, so delta idle / HZ / 60
+    # is core-minutes. I/O wait is recorded separately, never called idle capacity.
+    cpu = [int(v) for v in Path('/proc/stat').read_text().splitlines()[0].split()[1:]]
+    return dict(event=event,name=name,host=socket.gethostname(),wall_ns=time.time_ns(),
+                monotonic_ns=time.monotonic_ns(),boot_id=Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
+                cores=os.cpu_count(),clock_ticks=os.sysconf('SC_CLK_TCK'),idle_ticks=cpu[3],iowait_ticks=cpu[4],
+                cpu_ticks=cpu[:8],load=Path('/proc/loadavg').read_text().strip())
+
+
+def idle_between(before, after):
+    if any(before[k] != after[k] for k in ('host','boot_id','clock_ticks','cores')):
+        raise ValueError('incompatible snapshots')
+    dt = (after['monotonic_ns']-before['monotonic_ns'])/1e9
+    delta = after['idle_ticks']-before['idle_ticks']
+    if dt <= 0 or delta < 0:
+        raise ValueError('non-monotone CPU counters')
+    return dict(elapsed_minutes=dt/60,idle_core_minutes=delta/before['clock_ticks']/60,
+                mean_idle_cores=delta/before['clock_ticks']/dt,
+                reclaimable_core_minutes=None)  # reservations and the team cap still need measurement
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('event')
+    parser.add_argument('name')
+    parser.add_argument('--output',type=Path,default=Path('reorder/capacity.jsonl'))
+    args = parser.parse_args()
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    payload = (json.dumps(snapshot(args.event,args.name),separators=(',',':'))+'\n').encode()
+    fd = os.open(args.output,os.O_WRONLY | os.O_APPEND | os.O_CREAT,0o600)
+    try:
+        if os.write(fd,payload) != len(payload):
+            raise OSError('incomplete capacity snapshot write')
+        os.fsync(fd)
+    finally:
+        os.close(fd)
